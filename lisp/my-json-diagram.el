;;; my-json-diagram.el --- Clickable nested JSON path diagrams -*- lexical-binding: t; -*-

;; Renderer for the JSON reference information maintained by init.org.
;; Native SVG only; no Graphviz, browser or external rendering service.

(require 'cl-lib)
(require 'button)
(defvar my/json-reference-info)
(defvar my/json-reference-mode-map)
(defvar my/json-reference-emulation-alist)
(defvar my/combobulate-structure-origin-file)
(declare-function my/json-python-literal "init")
(declare-function my/html-json-scripts "init")
(declare-function my/combobulate-structure-quit "init")

(defun my/json-diagram-short (text width)
  (truncate-string-to-width (replace-regexp-in-string "[\n\r\t]" " " text) (max 8 width) nil nil "…"))

(defun my/json-diagram-position (node)
  (let ((parent (treesit-node-parent node)))
    (copy-marker (treesit-node-start
                  (if (equal (treesit-node-type parent) "pair")
                      (treesit-node-child-by-field-name parent "key") node)))))

(defun my/json-diagram-items (info)
  "Capture only the path and at most four real nearby children per container."
  (let ((nodes (plist-get info :nodes)) (parts (cons nil (plist-get info :parts))) items)
    (cl-loop for rest on nodes for part in parts for depth from 0 do
             (let* ((node (car rest)) (next (cadr rest))
                    (type (treesit-node-type node))
                    (count (treesit-node-child-count node t))
                    (label (if (zerop depth) "data"
                             (format "[%s]" (if (integerp part) part (my/json-python-literal part)))))
                    (entry (list :label label :key part :type type :count count
                                 :position (my/json-diagram-position node)))
                    indices
                    children)
               (when (member type '("object" "array"))
                 (setq indices
                       (if (equal type "array")
                           (let ((index (if next (treesit-node-index next t) 0)))
                             (number-sequence (max 0 (1- index)) (min (1- count) (1+ index))))
                         (number-sequence 0 (min 2 (1- count)))))
                 (dolist (index indices)
                   (let* ((child (treesit-node-child node index t))
                          (pair (equal (treesit-node-type child) "pair"))
                          (value (if pair (treesit-node-child-by-field-name child "value") child))
                          (key (if pair (json-parse-string (treesit-node-text (treesit-node-child-by-field-name child "key") t)) index)))
                     (push (list :label (concat (format "[%s]" (if (integerp key) key (my/json-python-literal key)))
                                               (unless (member (treesit-node-type value) '("object" "array"))
                                                 (concat " = " (buffer-substring-no-properties (treesit-node-start value)
                                                               (min (treesit-node-end value) (+ 80 (treesit-node-start value)))))))
                                 :position (my/json-diagram-position value)
                                 :selected (and next (treesit-node-eq next value))) children)))
                 (when (and next (not (cl-some (lambda (c) (plist-get c :selected)) children)))
                   (push (list :label (format "[%s]" (let ((key (nth depth (plist-get info :parts))))
                                                    (if (integerp key) key (my/json-python-literal key))))
                               :position (my/json-diagram-position next) :selected t) children))
                 (setq entry (plist-put entry :children (nreverse children))))
               (when (and (not (member type '("object" "array"))) (< (- (treesit-node-end node) (treesit-node-start node)) 300))
                 (setq entry (plist-put entry :value (treesit-node-text node t))))
               (push entry items)))
    (nreverse items)))

(defun my/json-diagram-jump (id)
  "Return to a real JSON key/value, or to the source HTML script tag."
  (let* ((target (cdr (assq id my/json-diagram-targets)))
         (source (plist-get target :buffer))
         (position (plist-get target :position))
         (origin (plist-get target :origin)))
    (if origin
        (progn
          (unless (buffer-live-p source)
            (let ((file (plist-get origin :file)))
              (unless (and file (file-exists-p file)) (user-error "Source HTML is no longer available"))
              (setq source (find-file-noselect file))))
          (setq position
                (with-current-buffer source
                  (let ((entry (cl-find-if
                                (lambda (e) (and (equal (plist-get e :id) (plist-get origin :id))
                                                 (equal (plist-get e :type) (plist-get origin :type))
                                                 (= (plist-get e :selector-index) (plist-get origin :selector-index))))
                                (my/html-json-scripts))))
                    (or (plist-get entry :tag-start) (plist-get origin :tag-start)
                        (save-excursion (goto-char (point-min)) (forward-line (1- (plist-get origin :line))) (point)))))))
      (unless (and (buffer-live-p source) (marker-buffer position))
        (user-error "Source JSON closed; reopen it with SPC j j"))
      (unless (= (buffer-chars-modified-tick source) (plist-get target :tick))
        (user-error "Source JSON changed; reopen this diagram")))
    (my/combobulate-structure-quit)
    (switch-to-buffer source)
    (goto-char position)
    (recenter)))

(defvar-local my/json-diagram-targets nil)
(defvar-local my/json-diagram-items nil)
(defvar-local my/json-diagram-source nil)
(defvar-local my/json-diagram-origin nil)
(defvar-local my/json-diagram-source-tick nil)
(defvar-local my/json-diagram-drawing nil)

(defun my/json-diagram-svg (items origin source width)
  "Draw nested container boxes and a snake-shaped path with real hit targets."
  (require 'svg)
  (let* ((columns (max 1 (min 3 (/ (- width 20) 300))))
         (margin 20) (gap 42) (card-width (/ (- width (* 2 margin) (* gap (1- columns))) columns))
         (card-height 218) (row-step 274) (top 132)
         (rows (ceiling (length items) columns))
         (height (+ top (* rows row-step)))
         (svg (svg-create width height))
         (dark (eq (frame-parameter nil 'background-mode) 'dark))
         (bg (if dark "#1e1e2e" "#eff1f5"))
         (fg (if dark "#cdd6f4" "#4c4f69"))
         (fill (if dark "#313244" "#e6e9ef"))
         (accent (if dark "#89b4fa" "#1e66f5"))
         (muted (if dark "#a6adc8" "#6c6f85"))
         (chars (max 12 (/ (- card-width 36) 10)))
         (tick (buffer-chars-modified-tick source))
         positions maps targets)
    (cl-labels
        ((text (s x y &rest attrs)
           (let ((props (list :x x :y y :font-family "monospace" :font-size 15 :fill fg)))
             (while attrs (setq props (plist-put props (pop attrs) (pop attrs))))
             (apply #'svg-text svg s props)))
         (hit (id x y w h target tip)
           (push (list (cons 'rect (cons (cons x y) (cons (+ x w) (+ y h)))) id
                       (list 'help-echo tip 'pointer 'hand)) maps)
           (push (cons id target) targets))
         (arrow (x1 y1 x2 y2)
           (svg-line svg x1 y1 x2 y2 :stroke accent :stroke-width 2)
           (let ((dx (- x2 x1)) (dy (- y2 y1)))
             (svg-polygon svg
                          (cond ((> dy 0) (list (cons x2 y2) (cons (- x2 6) (- y2 10)) (cons (+ x2 6) (- y2 10))))
                                ((> dx 0) (list (cons x2 y2) (cons (- x2 10) (- y2 6)) (cons (- x2 10) (+ y2 6))))
                                (t (list (cons x2 y2) (cons (+ x2 10) (- y2 6)) (cons (+ x2 10) (+ y2 6)))))
                          :fill accent))))
      (svg-rectangle svg 0 0 width height :fill bg)
      (text (my/json-diagram-short (if origin (or (plist-get origin :file) (plist-get origin :buffer-name)) "JSON") (/ (- width 40) 9))
            (/ width 2) 28 :text-anchor "middle" :font-size 14)
      (text (my/json-diagram-short (if origin (plist-get origin :tag) "JSON 根对象") (/ (- width 40) 10))
            (/ width 2) 58 :text-anchor "middle" :font-weight "bold" :fill accent :font-size 17)
      (text (my/json-diagram-short "点击标签回 HTML · 点击方框回 JSON · 高亮小框是下一层 · q 返回 · g 重排" (/ (- width 32) 8))
            (/ width 2) 88 :text-anchor "middle" :font-size 12 :fill muted)
      (when origin
        (hit 'json-html 12 6 (- width 24) 66 (list :buffer (buffer-local-value 'my/html-json-source-buffer source) :origin origin)
             (concat "跳到源 HTML 标签\n" (plist-get origin :tag))))
      (cl-loop for item in items for i from 0 do
               (let* ((row (/ i columns)) (slot (% i columns))
                      (col (if (zerop (% row 2)) slot (- columns slot 1)))
                      (x (+ margin (* col (+ card-width gap))))
                      (y (+ top (* row row-step)))
                      (id (intern (format "json-node-%d" i)))
                      (type (plist-get item :type))
                      (container (member type '("object" "array")))
                      (label (plist-get item :label)))
                 (push (list x y) positions)
                 (svg-rectangle svg x y card-width card-height :rx 10 :fill fill :stroke accent :stroke-width 1.5)
                 (text (format "%d  %s%s" i (pcase type ("object" "字典 {}") ("array" "列表 []") (_ type))
                               (if container (format " · %d 项" (plist-get item :count)) ""))
                       (+ x 14) (+ y 23) :font-size 12 :fill muted)
                 (text (my/json-diagram-short label chars) (+ x 14) (+ y 51) :font-weight "bold" :fill accent)
                 (hit id x y card-width 66 (list :buffer source :tick tick :position (plist-get item :position) :label label)
                      (concat label "\n点击跳到 JSON 对应位置"))
                 (if container
                     (cl-loop for child in (plist-get item :children) for j from 0 below 4 do
                              (let ((cy (+ y 72 (* j 31))) (selected (plist-get child :selected))
                                    (cid (intern (format "json-child-%d-%d" i j))))
                                (svg-rectangle svg (+ x 12) cy (- card-width 24) 27 :rx 4
                                               :fill bg :stroke (if selected accent muted) :stroke-width (if selected 2 0.5))
                                (text (concat (if selected "→ " "  ") (my/json-diagram-short (plist-get child :label) (- chars 2)))
                                      (+ x 20) (+ cy 19) :font-size 13 :fill (if selected accent muted))
                                (hit cid (+ x 12) cy (- card-width 24) 27
                                     (list :buffer source :tick tick :position (plist-get child :position))
                                     (plist-get child :label))))
                   (text (my/json-diagram-short (or (plist-get item :value) "") (/ (- card-width 32) 12))
                         (+ x 14) (+ y 112) :font-size 20 :fill accent))))
      (setq positions (nreverse positions))
      (cl-loop for prev in positions for next in (cdr positions) for i from 0 do
               (let ((x1 (car prev)) (y1 (cadr prev)) (x2 (car next)) (y2 (cadr next)))
                 (if (= y1 y2)
                     (if (< x1 x2)
                         (arrow (+ x1 card-width) (+ y1 108) x2 (+ y2 108))
                       (arrow x1 (+ y1 108) (+ x2 card-width) (+ y2 108)))
                   (arrow (+ x1 (/ card-width 2)) (+ y1 card-height) (+ x2 (/ card-width 2)) y2))))
      (list :svg svg :width width :height height :map (nreverse maps) :targets (nreverse targets)))))

(defun my/json-diagram-redraw ()
  (interactive)
  (unless (buffer-live-p my/json-diagram-source)
    (user-error "Source JSON closed; reopen it with SPC j j"))
  (when (and my/json-diagram-source-tick
             (/= my/json-diagram-source-tick (buffer-chars-modified-tick my/json-diagram-source)))
    (user-error "Source JSON changed; reopen this diagram"))
  (let* ((drawing (my/json-diagram-svg my/json-diagram-items my/json-diagram-origin my/json-diagram-source
                                      (max 300 (min 1500 (- (window-body-width nil t) 14)))))
         (inhibit-read-only t)
         (map (copy-keymap my/json-reference-mode-map)))
    (setq my/json-diagram-targets (plist-get drawing :targets)
          my/json-diagram-drawing drawing)
    (erase-buffer)
    (dolist (target my/json-diagram-targets)
      (let ((id (car target)))
        (define-key map (vector id 'mouse-1) (lambda (_event) (interactive "e") (my/json-diagram-jump id)))))
    (define-key map (kbd "g") #'my/json-diagram-redraw)
    (define-key map (kbd "v") #'my/json-diagram-show-code)
    (define-key map (kbd "s") #'my/json-diagram-export)
    (define-key map (kbd "RET") #'push-button)
    (define-key map (kbd "<return>") #'push-button)
    (define-key map (kbd "TAB") #'forward-button)
    (define-key map (kbd "<tab>") #'forward-button)
    (define-key map (kbd "<backtab>") #'backward-button)
    (define-key map (kbd "S-<tab>") #'backward-button)
    (setq-local my/json-reference-emulation-alist `((my/json-reference-mode . ,map)))
    (if (and (display-graphic-p) (image-type-available-p 'svg))
        (let ((image (svg-image (plist-get drawing :svg) :scale 1.0 :map (plist-get drawing :map))))
          (insert-sliced-image image " " nil (max 1 (ceiling (plist-get drawing :height) 200)) 1))
      (insert "JSON 层级关系（当前终端使用文字版）\n")
      (when my/json-diagram-origin
        (insert (format "来源：%s\n原始标签：%s\n" (or (plist-get my/json-diagram-origin :file) "HTML")
                        (plist-get my/json-diagram-origin :tag))))
      (insert "\n")
      (dolist (item my/json-diagram-items)
        (insert (format "┌─ %s ─ %s\n└──────────\n       ↓\n" (plist-get item :label) (plist-get item :type)))))
    (insert "\n节点跳转（Tab 选择，Enter 跳转）\n")
    (dolist (target my/json-diagram-targets)
      (when (or (eq (car target) 'json-html) (string-prefix-p "json-node-" (symbol-name (car target))))
        (let ((id (car target)))
          (insert-text-button (if (eq id 'json-html) "源 HTML 标签" (my/json-diagram-short (plist-get (cdr target) :label) 28))
                              'follow-link t 'action (lambda (_) (my/json-diagram-jump id)))
          (insert "  "))))
    (cl-loop for item in my/json-diagram-items for i from 0
             when (and (stringp (plist-get item :key)) (> (string-width (plist-get item :key)) 38)) do
             (insert (format "\n\n节点 %d 的完整字符串键（单个键，不是额外字典层级）：\n%s\n" i (plist-get item :key))))
    (insert "\nv：可选代码页 · g：恢复图示/按当前窗口重排 · s：导出 SVG · q：返回\n")
    (goto-char (point-min))
    (set-buffer-modified-p nil)))

(defun my/json-diagram-show-code ()
  (interactive)
  (let ((inhibit-read-only t))
    (erase-buffer)
    (insert (plist-get my/json-reference-info :code-text))
    (goto-char (point-min))
    (set-buffer-modified-p nil)))

(defun my/json-diagram-export ()
  "Export the current diagram, rather than its image placeholder text."
  (interactive)
  (unless my/combobulate-structure-origin-file (user-error "No original file for this diagram"))
  (let ((file (concat (file-name-sans-extension my/combobulate-structure-origin-file) ".path.svg"))
        (coding-system-for-write 'utf-8-unix))
    (unless (or (not (file-exists-p file)) (yes-or-no-p (format "Overwrite %s? " file)))
      (user-error "Diagram export cancelled"))
    (with-temp-file file (svg-print (plist-get my/json-diagram-drawing :svg)))
    (message "JSON diagram exported: %s" file)))

(provide 'my-json-diagram)
;;; my-json-diagram.el ends here
